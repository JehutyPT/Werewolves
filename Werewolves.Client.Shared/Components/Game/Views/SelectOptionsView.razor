@using Werewolves.Core.StateModels.Models
@using Werewolves.Core.StateModels.Models.Instructions

<div class="ww-option-list" role="group" aria-label="@ClientStrings.SelectOptions_Title">
	@foreach (var option in Instruction.Options)
	{
		<button type="button"
				@key="option.Id"
				class="@OptionClass(option.Id)"
				aria-pressed="@AriaPressed(option.Id)"
				@onclick="() => ToggleOption(option.Id)">@option.Label</button>
	}
</div>

<span class="ww-selection-count">@SelectionCountLabel</span>

<footer class="ww-dashboard-action-zone" data-testid="@ModeratorUiTestIds.DashboardActionZone">
	<HoldButton Label="@ClientStrings.Dashboard_ContinueButton"
				Disabled="@(!IsSelectionValid)"
				OnHoldComplete="HandleSubmit" />
</footer>

@code {
	private readonly HashSet<string> _selectedOptionIds = new(StringComparer.Ordinal);

	[Parameter, EditorRequired]
	public SelectOptionsInstruction Instruction { get; set; } = default!;

	[Parameter]
	public EventCallback<ModeratorResponse> OnResponse { get; set; }

	private bool IsSelectionValid => Instruction.SelectionRange.IsValid(_selectedOptionIds);

	private string SelectionCountLabel =>
		string.Format(
			System.Globalization.CultureInfo.CurrentCulture,
			ClientStrings.SelectOptions_SelectionCountFormat,
			_selectedOptionIds.Count,
			Instruction.SelectionRange.Maximum);

	private void ToggleOption(string optionId)
	{
		if (!_selectedOptionIds.Remove(optionId))
		{
			if (Instruction.SelectionRange.Maximum == 1)
			{
				_selectedOptionIds.Clear();
				_selectedOptionIds.Add(optionId);
			}
			else if (_selectedOptionIds.Count < Instruction.SelectionRange.Maximum)
			{
				_selectedOptionIds.Add(optionId);
			}
		}
	}

	private Task HandleSubmit()
	{
		var response = Instruction.CreateResponse(_selectedOptionIds.ToArray());
		return OnResponse.InvokeAsync(response);
	}

	private string OptionClass(string optionId) =>
		_selectedOptionIds.Contains(optionId)
			? "ww-option-btn ww-option-btn--selected"
			: "ww-option-btn";

	private string AriaPressed(string optionId) =>
		_selectedOptionIds.Contains(optionId) ? "true" : "false";
}
