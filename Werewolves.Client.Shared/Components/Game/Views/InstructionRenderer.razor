@using Werewolves.Client.Services
@using Werewolves.Core.StateModels.Models
@using Werewolves.Core.StateModels.Models.Instructions
@inject IHapticFeedbackService Haptic

<div class="ww-instruction-stack" @key="TransitionKey">
	@if (!_presentation.HasInstruction)
	{
		<p class="ww-empty-state">@ClientStrings.Dashboard_NoInstruction</p>
	}
	else
	{
		if (_presentation.HasPublicGuidance)
		{
			var publicExpanded = IsExpanded(InstructionSection.Public);

			<button type="button"
					class="@InstructionBlockClass(InstructionSection.Public, publicExpanded)"
					data-testid="@ModeratorUiTestIds.InstructionBlock"
					aria-expanded="@AriaExpanded(publicExpanded)"
					aria-label="@InstructionToggleLabel(ClientStrings.Dashboard_AnnounceLabel)"
					@onclick="() => Toggle(InstructionSection.Public)">
				<span class="ww-label ww-label--accent">@ClientStrings.Dashboard_AnnounceLabel</span>
				<span class="@InstructionTextClass(InstructionSection.Public, publicExpanded)">
					@InstructionText(Instruction!.PublicAnnouncement, publicExpanded)
				</span>
				@if (!publicExpanded)
				{
					<span class="ww-labs-expand-hint">@ClientStrings.Common_TapToExpand</span>
				}
			</button>
		}

		if (_presentation.HasPrivateGuidance)
		{
			var privateExpanded = IsExpanded(InstructionSection.Private);

			<button type="button"
					class="@InstructionBlockClass(InstructionSection.Private, privateExpanded)"
					data-testid="@ModeratorUiTestIds.InstructionBlock"
					aria-expanded="@AriaExpanded(privateExpanded)"
					aria-label="@InstructionToggleLabel(ClientStrings.Dashboard_ModeratorLabel)"
					@onclick="() => Toggle(InstructionSection.Private)">
				<span class="ww-label">@ClientStrings.Dashboard_ModeratorLabel</span>
				<span class="@InstructionTextClass(InstructionSection.Private, privateExpanded)">
					@InstructionText(Instruction!.PrivateInstruction, privateExpanded)
				</span>
				@if (!privateExpanded)
				{
					<span class="ww-labs-expand-hint">@ClientStrings.Common_TapToExpand</span>
				}
			</button>
		}
	}

	@if (_presentation.HasInstruction)
	{
		switch (_presentation.ResponseSurface)
		{
			case InstructionResponseSurface.DevotedServantVoteWindow:
				var devotedServantVoteWindowInstruction = (DevotedServantVoteWindowInstruction)Instruction!;
				<DevotedServantVoteWindowView Instruction="devotedServantVoteWindowInstruction"
											Roster="Roster"
											OnResponse="OnResponse" />
				break;
			case InstructionResponseSurface.SelectPlayers:
				var selectPlayersInstruction = (SelectPlayersInstruction)Instruction!;
				<SelectPlayersView Instruction="selectPlayersInstruction" Roster="Roster" OnResponse="OnResponse" />
				break;
			case InstructionResponseSurface.SelectOptions:
				var selectOptionsInstruction = (SelectOptionsInstruction)Instruction!;
				<SelectOptionsView Instruction="selectOptionsInstruction" OnResponse="OnResponse" />
				break;
			case InstructionResponseSurface.AssignRoles:
				var assignRolesInstruction = (AssignRolesInstruction)Instruction!;
				<AssignRolesView Instruction="assignRolesInstruction" OnResponse="OnResponse" Roster="Roster" />
				break;
		}
	}
</div>

@if (ShouldRenderDashboardActionZone)
{
	<footer class="ww-dashboard-action-zone" data-testid="@ModeratorUiTestIds.DashboardActionZone">
		@if (AudioControls is not null)
		{
			@AudioControls
		}

		@if (_presentation.HasInstruction)
		{
			switch (_presentation.ResponseSurface)
			{
				case InstructionResponseSurface.Confirmation:
					var confirmationInstruction = (ConfirmationInstruction)Instruction!;
					<ConfirmationView @key="confirmationInstruction"
									  Instruction="confirmationInstruction"
									  OnResponse="OnResponse" />
					break;
				case InstructionResponseSurface.Unavailable:
					<button type="button" class="ww-btn-primary" disabled>@ClientStrings.Dashboard_RespondButton</button>
					break;
			}
		}
	</footer>
}

@code {
	private InstructionPresentation _presentation;
	private ModeratorInstruction? _renderedInstruction;
	private InstructionSection _expandedSections;
	private int _transitionVersion;

	[Parameter]
	public ModeratorInstruction? Instruction { get; set; }

	[Parameter]
	public EventCallback<ModeratorResponse> OnResponse { get; set; }

	[Parameter]
	public IReadOnlyList<DashboardRosterEntry> Roster { get; set; } = [];

	[Parameter]
	public RenderFragment? AudioControls { get; set; }

	protected override void OnParametersSet()
	{
		if (!ReferenceEquals(_renderedInstruction, Instruction))
		{
			_renderedInstruction = Instruction;
			_presentation = InstructionPresentation.For(Instruction);
			_expandedSections = _presentation.InitialExpandedSections;
			_transitionVersion++;
		}
	}

	private object? TransitionKey =>
		_presentation.HasInstruction ? _transitionVersion : null;

	private bool ShouldRenderDashboardActionZone =>
		AudioControls is not null ||
		_presentation.ResponseSurface is
			InstructionResponseSurface.Confirmation or
			InstructionResponseSurface.Unavailable;

	private bool IsExpanded(InstructionSection section) =>
		_expandedSections.HasFlag(section);

	private static string InstructionBlockClass(InstructionSection section, bool isExpanded)
	{
		var blockKind = section == InstructionSection.Public
			? "ww-instruction-block--announcement"
			: "ww-instruction-block--private";
		var expandedClass = isExpanded ? " is-expanded" : string.Empty;

		return $"ww-instruction-block {blockKind} ww-labs-collapsible{expandedClass}";
	}

	private static string InstructionTextClass(InstructionSection section, bool isExpanded)
	{
		var textKind = section == InstructionSection.Public
			? "ww-announcement"
			: "ww-private-instruction";
		var previewClass = isExpanded ? string.Empty : " ww-labs-preview";

		return $"ww-instruction-text {textKind}{previewClass}";
	}

	private static string InstructionText(string? text, bool isExpanded) =>
		isExpanded || string.IsNullOrWhiteSpace(text)
			? text ?? string.Empty
			: FirstLine(text);

	private static string FirstLine(string text)
	{
		var newlineIndex = text.IndexOf('\n');
		return newlineIndex >= 0 ? text[..newlineIndex] + ClientStrings.Common_CollapsedTextSuffix : text;
	}

	private void Toggle(InstructionSection section)
	{
		if (_presentation.GuidanceExpansion == GuidanceExpansion.Exclusive)
		{
			if (_expandedSections.HasFlag(section))
			{
				return;
			}

			_expandedSections = section;
			Haptic.TryClick();
			return;
		}

		_expandedSections = _expandedSections.HasFlag(section)
			? _expandedSections & ~section
			: _expandedSections | section;
		Haptic.TryClick();
	}

	private static string InstructionToggleLabel(string label) =>
		label;

	private static string AriaExpanded(bool isExpanded) =>
		isExpanded ? "true" : "false";

	[Flags]
	private enum InstructionSection { None = 0, Public = 1, Private = 2 }

	private enum GuidanceExpansion
	{
		Independent,
		Exclusive
	}

	private enum InstructionResponseSurface
	{
		None,
		Unavailable,
		Confirmation,
		DevotedServantVoteWindow,
		SelectPlayers,
		SelectOptions,
		AssignRoles
	}

	private readonly record struct InstructionPresentation(
		bool HasInstruction,
		bool HasPublicGuidance,
		bool HasPrivateGuidance,
		InstructionSection InitialExpandedSections,
		GuidanceExpansion GuidanceExpansion,
		InstructionResponseSurface ResponseSurface)
	{
		public static InstructionPresentation For(ModeratorInstruction? instruction)
		{
			if (instruction is null)
			{
				return default;
			}

			var hasPublicGuidance = !string.IsNullOrWhiteSpace(instruction.PublicAnnouncement);
			var hasPrivateGuidance = !string.IsNullOrWhiteSpace(instruction.PrivateInstruction);

			return instruction switch
			{
				DevotedServantVoteWindowInstruction => DataEntry(
					hasPublicGuidance,
					hasPrivateGuidance,
					InstructionResponseSurface.DevotedServantVoteWindow),
				SelectPlayersInstruction => DataEntry(
					hasPublicGuidance,
					hasPrivateGuidance,
					InstructionResponseSurface.SelectPlayers),
				SelectOptionsInstruction => DataEntry(
					hasPublicGuidance,
					hasPrivateGuidance,
					InstructionResponseSurface.SelectOptions),
				AssignRolesInstruction => DataEntry(
					hasPublicGuidance,
					hasPrivateGuidance,
					InstructionResponseSurface.AssignRoles),
				ConfirmationInstruction => Passive(
					hasPublicGuidance,
					hasPrivateGuidance,
					InstructionResponseSurface.Confirmation),
				FinishedGameConfirmationInstruction => Passive(
					hasPublicGuidance,
					hasPrivateGuidance,
					InstructionResponseSurface.Unavailable),
				_ => Passive(
					hasPublicGuidance,
					hasPrivateGuidance,
					InstructionResponseSurface.Unavailable)
			};
		}

		private static InstructionPresentation DataEntry(
			bool hasPublicGuidance,
			bool hasPrivateGuidance,
			InstructionResponseSurface responseSurface) =>
			new(
				HasInstruction: true,
				hasPublicGuidance,
				hasPrivateGuidance,
				FirstAvailableGuidance(hasPublicGuidance, hasPrivateGuidance),
				GuidanceExpansion.Exclusive,
				responseSurface);

		private static InstructionPresentation Passive(
			bool hasPublicGuidance,
			bool hasPrivateGuidance,
			InstructionResponseSurface responseSurface) =>
			new(
				HasInstruction: true,
				hasPublicGuidance,
				hasPrivateGuidance,
				AllAvailableGuidance(hasPublicGuidance, hasPrivateGuidance),
				GuidanceExpansion.Independent,
				responseSurface);

		private static InstructionSection FirstAvailableGuidance(
			bool hasPublicGuidance,
			bool hasPrivateGuidance) =>
			hasPublicGuidance
				? InstructionSection.Public
				: hasPrivateGuidance
					? InstructionSection.Private
					: InstructionSection.None;

		private static InstructionSection AllAvailableGuidance(
			bool hasPublicGuidance,
			bool hasPrivateGuidance)
		{
			var sections = InstructionSection.None;
			if (hasPublicGuidance)
			{
				sections |= InstructionSection.Public;
			}

			if (hasPrivateGuidance)
			{
				sections |= InstructionSection.Private;
			}

			return sections;
		}
	}
}
