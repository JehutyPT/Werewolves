@using Werewolves.Client.Services
@using Werewolves.Core.StateModels.Models
@using Werewolves.Core.StateModels.Models.Instructions
@inject IHapticFeedbackService Haptic

<div class="ww-instruction-stack" @key="_flow.TransitionKey">
	@if (!_flow.HasInstruction)
	{
		<p class="ww-empty-state">@ClientStrings.Dashboard_NoInstruction</p>
	}
	else
	{
		if (HasPublicAnnouncement)
		{
			var publicExpanded = IsExpanded(InstructionSection.Public);

			<button type="button"
					class="@InstructionBlockClass(InstructionSection.Public, publicExpanded)"
					data-testid="@ModeratorUiTestIds.InstructionBlock"
					aria-expanded="@AriaExpanded(publicExpanded)"
					aria-label="@InstructionToggleLabel(ClientStrings.Dashboard_AnnounceLabel)"
					@onclick="() => Toggle(InstructionSection.Public)">
				<span class="ww-label ww-label--accent">@ClientStrings.Dashboard_AnnounceLabel</span>
				<span class="@InstructionTextClass(InstructionSection.Public, publicExpanded)">
					@InstructionText(Instruction!.PublicAnnouncement, publicExpanded)
				</span>
				@if (!publicExpanded)
				{
					<span class="ww-labs-expand-hint">@ClientStrings.Common_TapToExpand</span>
				}
			</button>
		}

		if (HasPrivateInstruction)
		{
			var privateExpanded = IsExpanded(InstructionSection.Private);

			<button type="button"
					class="@InstructionBlockClass(InstructionSection.Private, privateExpanded)"
					data-testid="@ModeratorUiTestIds.InstructionBlock"
					aria-expanded="@AriaExpanded(privateExpanded)"
					aria-label="@InstructionToggleLabel(ClientStrings.Dashboard_ModeratorLabel)"
					@onclick="() => Toggle(InstructionSection.Private)">
				<span class="ww-label">@ClientStrings.Dashboard_ModeratorLabel</span>
				<span class="@InstructionTextClass(InstructionSection.Private, privateExpanded)">
					@InstructionText(Instruction!.PrivateInstruction, privateExpanded)
				</span>
				@if (!privateExpanded)
				{
					<span class="ww-labs-expand-hint">@ClientStrings.Common_TapToExpand</span>
				}
			</button>
		}
	}

	@if (_flow.HasInstruction)
	{
		if (Instruction is DevotedServantVoteWindowInstruction devotedServantVoteWindowInstruction)
		{
			<DevotedServantVoteWindowView Instruction="devotedServantVoteWindowInstruction"
										Roster="Roster"
										OnResponse="OnResponse" />
		}
		else if (Instruction is SelectPlayersInstruction selectPlayersInstruction)
		{
			<SelectPlayersView Instruction="selectPlayersInstruction" Roster="Roster" OnResponse="OnResponse" />
		}
		else if (Instruction is SelectOptionsInstruction selectOptionsInstruction)
		{
			<SelectOptionsView Instruction="selectOptionsInstruction" OnResponse="OnResponse" />
		}
		else if (Instruction is AssignRolesInstruction assignRolesInstruction)
		{
			<AssignRolesView Instruction="assignRolesInstruction" OnResponse="OnResponse" Roster="Roster" />
		}
	}
</div>

@if (ShouldRenderDashboardActionZone)
{
	<footer class="ww-dashboard-action-zone" data-testid="@ModeratorUiTestIds.DashboardActionZone">
		@if (AudioControls is not null)
		{
			@AudioControls
		}

		@if (_flow.HasInstruction)
		{
			if (Instruction is ConfirmationInstruction confirmationInstruction)
			{
				<ConfirmationView @key="confirmationInstruction"
								  Instruction="confirmationInstruction"
								  OnResponse="OnResponse" />
			}
			else if (Instruction is not (DevotedServantVoteWindowInstruction or SelectPlayersInstruction or SelectOptionsInstruction or AssignRolesInstruction))
			{
				<button type="button" class="ww-btn-primary" disabled>@ClientStrings.Dashboard_RespondButton</button>
			}
		}
	</footer>
}

@code {
	private readonly InstructionDisplayFlow _flow = new();
	private InstructionSection _expandedSections;

	[Parameter]
	public ModeratorInstruction? Instruction { get; set; }

	[Parameter]
	public EventCallback<ModeratorResponse> OnResponse { get; set; }

	[Parameter]
	public IReadOnlyList<DashboardRosterEntry> Roster { get; set; } = [];

	[Parameter]
	public RenderFragment? AudioControls { get; set; }

	protected override void OnParametersSet()
	{
		var previousInstruction = _flow.Instruction;
		_flow.SetInstruction(Instruction);

		if (!ReferenceEquals(previousInstruction, Instruction))
		{
			_expandedSections = InitialExpandedSections(Instruction);
		}
	}

	private bool HasPublicAnnouncement =>
		!string.IsNullOrWhiteSpace(Instruction?.PublicAnnouncement);

	private bool HasPrivateInstruction =>
		!string.IsNullOrWhiteSpace(Instruction?.PrivateInstruction);

	private bool ShouldRenderDashboardActionZone =>
		AudioControls is not null ||
		(_flow.HasInstruction &&
			Instruction is not (DevotedServantVoteWindowInstruction or SelectPlayersInstruction or SelectOptionsInstruction or AssignRolesInstruction));

	private bool IsExpanded(InstructionSection section) =>
		_expandedSections.HasFlag(section);

	private static string InstructionBlockClass(InstructionSection section, bool isExpanded)
	{
		var blockKind = section == InstructionSection.Public
			? "ww-instruction-block--announcement"
			: "ww-instruction-block--private";
		var expandedClass = isExpanded ? " is-expanded" : string.Empty;

		return $"ww-instruction-block {blockKind} ww-labs-collapsible{expandedClass}";
	}

	private static string InstructionTextClass(InstructionSection section, bool isExpanded)
	{
		var textKind = section == InstructionSection.Public
			? "ww-announcement"
			: "ww-private-instruction";
		var previewClass = isExpanded ? string.Empty : " ww-labs-preview";

		return $"ww-instruction-text {textKind}{previewClass}";
	}

	private static string InstructionText(string? text, bool isExpanded) =>
		isExpanded || string.IsNullOrWhiteSpace(text)
			? text ?? string.Empty
			: FirstLine(text);

	private static string FirstLine(string text)
	{
		var newlineIndex = text.IndexOf('\n');
		return newlineIndex >= 0 ? text[..newlineIndex] + ClientStrings.Common_CollapsedTextSuffix : text;
	}

	private void Toggle(InstructionSection section)
	{
		if (Instruction is not null && ModeratorInstructionDisplayDefaults.RequiresModeratorDataEntryForDisplay(Instruction))
		{
			if (_expandedSections.HasFlag(section))
			{
				return;
			}

			_expandedSections = section;
			Haptic.TryClick();
			return;
		}

		_expandedSections = _expandedSections.HasFlag(section)
			? _expandedSections & ~section
			: _expandedSections | section;
		Haptic.TryClick();
	}

	private static InstructionSection InitialExpandedSections(ModeratorInstruction? instruction)
	{
		if (instruction is not null && !ModeratorInstructionDisplayDefaults.RequiresModeratorDataEntryForDisplay(instruction))
		{
			var expandedSections = InstructionSection.None;
			if (!string.IsNullOrWhiteSpace(instruction.PublicAnnouncement))
			{
				expandedSections |= InstructionSection.Public;
			}

			if (!string.IsNullOrWhiteSpace(instruction.PrivateInstruction))
			{
				expandedSections |= InstructionSection.Private;
			}

			return expandedSections;
		}

		if (!string.IsNullOrWhiteSpace(instruction?.PublicAnnouncement))
		{
			return InstructionSection.Public;
		}

		if (!string.IsNullOrWhiteSpace(instruction?.PrivateInstruction))
		{
			return InstructionSection.Private;
		}

		return InstructionSection.None;
	}

	private static string InstructionToggleLabel(string label) =>
		label;

	private static string AriaExpanded(bool isExpanded) =>
		isExpanded ? "true" : "false";

	[Flags]
	private enum InstructionSection { None = 0, Public = 1, Private = 2 }
}
