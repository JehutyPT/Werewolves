@using Werewolves.Client.Services
@using Werewolves.Core.StateModels.Models
@using Werewolves.Core.StateModels.Models.Instructions

<ul class="ww-select-players-list" role="listbox" aria-label="@ClientStrings.SelectPlayers_ListAria">
	@foreach (var player in _state.SelectablePlayers)
	{
		var playerId = player.PlayerId;
		var isSelected = _state.IsSelected(playerId);
		<li class="ww-select-players-item @(isSelected ? "ww-select-players-item--selected" : "")"
			@key="playerId"
			@onclick="() => TogglePlayer(playerId)"
			role="option"
			aria-selected="@(isSelected ? "true" : "false")">
			<span class="ww-seat-number">@player.SeatNumber</span>
			<span class="ww-player-name">@player.Name</span>
			<span class="ww-select-players-check" aria-hidden="true">
				@if (isSelected) { <text>&#x2713;</text> }
			</span>
		</li>
	}
</ul>

<footer class="ww-dashboard-action-zone" data-testid="@ModeratorUiTestIds.DashboardActionZone">
	<HoldButton Label="@SubmitLabel"
				OnHoldComplete="HandleSubmit" />
</footer>

@code {
	private SelectPlayersInputState _state = null!;

	[Parameter, EditorRequired]
	public DevotedServantVoteWindowInstruction Instruction { get; set; } = default!;

	[Parameter, EditorRequired]
	public IReadOnlyList<DashboardRosterEntry> Roster { get; set; } = default!;

	[Parameter]
	public EventCallback<ModeratorResponse> OnResponse { get; set; }

	protected override void OnParametersSet()
	{
		_state = new SelectPlayersInputState(
			Roster,
			Instruction.SelectablePlayerIds,
			NumberRangeConstraint.Single);
	}

	private void TogglePlayer(Guid playerId)
	{
		if (_state.ToggleSelection(playerId))
		{
			StateHasChanged();
		}
	}

	private string SubmitLabel =>
		_state.CanSubmit
			? ClientStrings.SelectPlayers_SubmitButton
			: ClientStrings.Dashboard_ContinueButton;

	private Task HandleSubmit()
	{
		var selectedPlayerIds = _state.GetSelection();
		var response = selectedPlayerIds.Count == 0
			? Instruction.CreateContinueResponse()
			: Instruction.CreatePublicSelfRevealResponse(selectedPlayerIds.Single());
		return OnResponse.InvokeAsync(response);
	}
}
