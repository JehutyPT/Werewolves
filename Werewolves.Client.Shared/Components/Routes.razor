@using Werewolves.Client.Components.Pages
@using Werewolves.Core.StateModels.Models.Instructions
@using Werewolves.Core.StateModels.Enums
@using Werewolves.Core.StateModels.Models.Simulation
@using Werewolves.Core.GameLogic.Models
@implements IDisposable
@inject LobbySetupState Lobby
@inject GameClientManager Game
@inject GameplayWakeLockController WakeLock
@inject IRecentSetupStore RecentSetupStore
@inject LobbySetupMetadata LobbyMetadata
@inject TimeProvider Clock

@if (_currentStep == LobbyStep.Landing)
{
	<LandingPage CanContinue="Game.HasActiveSession"
				 RecentSetups="_recentSetups"
				 OnContinue="MoveToInitialStep"
				 OnNewGame="HandleNewGame"
				 OnRecentSetup="HandleRecentSetup"
				 OnDeleteRecentSetup="HandleDeleteRecentSetup" />
}
else if (_currentStep == LobbyStep.Roster)
{
	<LobbyRosterPage OnBack="ShowLanding" OnContinue="ShowRoleSelection" OnShowLabs="ShowLabs" />
}
else if (_currentStep == LobbyStep.RoleSelection)
{
	<RoleSelectionPage OnBack="ShowRoster"
						   OnConfigureRoleLockIn="ShowRoleLockIn"
						   OnConfigureActorSetupCards="ShowActorSetupCards"
						   OnConfigurePublicGroupPartition="ShowPublicGroupPartition"
						   OnLobbyExitAttempted="HandleLobbyExitOutcome" />
}
else if (_currentStep == LobbyStep.RoleLockIn)
{
	<ThiefRoleLockInPage OnBack="ShowRoleSelection" OnAccepted="ShowRoleSelection" />
}
else if (_currentStep == LobbyStep.ActorSetupCards)
{
	<ActorSetupCardsPage OnBack="ShowRoleSelection" OnAccepted="ShowRoleSelection" />
}
else if (_currentStep == LobbyStep.PublicGroupPartition)
{
	<PublicGroupPartitionPage OnBack="ShowRoleSelection" OnAccepted="ShowRoleSelection" />
}
else if (_currentStep == LobbyStep.Labs)
{
	<LabsPage OnBack="ShowRoster" />
}
else if (_currentStep == LobbyStep.Victory)
{
	<VictoryPage GameResult="_gameResult" VictoryCheckWindow="_victoryCheckWindow.GetValueOrDefault()" OnReturnToLobby="HandleReturnToLobby" />
}
else
{
	<DashboardPage OnAbandonGame="HandleReturnToLobby" />
}

@using Werewolves.Client.Services

@code {
	private LobbyStep _currentStep = LobbyStep.Landing;
	private GameResult? _gameResult;
	private VictoryCheckWindow? _victoryCheckWindow;
	private IReadOnlyList<RecentSetupRowPresentation> _recentSetups = [];

	protected override void OnInitialized()
	{
		Game.StateChanged += HandleGameStateChanged;
		RefreshRecentSetups();
		MoveTo(LobbyStep.Landing);
	}

	private void MoveToInitialStep()
	{
		if (Game.CurrentInstruction is FinishedGameConfirmationInstruction finished)
		{
			_gameResult = finished.GameResult;
			_victoryCheckWindow = finished.VictoryCheckWindow;
			MoveTo(LobbyStep.Victory);
			return;
		}

		MoveTo(Game.HasActiveSession ? LobbyStep.Dashboard : LobbyStep.Roster);
	}

	private void ShowRoleSelection()
	{
		MoveTo(LobbyStep.RoleSelection);
	}

	private void ShowRoster()
	{
		MoveTo(LobbyStep.Roster);
	}

	private void ShowLanding()
	{
		RefreshRecentSetups();
		MoveTo(LobbyStep.Landing);
	}

	private void HandleNewGame()
	{
		if (Game.HasActiveSession)
		{
			Game.ClearSession();
		}

		MoveTo(LobbyStep.Roster);
	}

	private void HandleRecentSetup(RecentSetup setup)
	{
		if (Game.TryAbandonSessionAndApplyRecentSetup(Lobby, setup))
		{
			MoveTo(LobbyStep.Roster);
		}
	}

	private void HandleDeleteRecentSetup(RecentSetup setup)
	{
		try
		{
			RecentSetupStore.Delete(setup);
			RefreshRecentSetups();
		}
		catch (Exception exception) when (
			exception is IOException or UnauthorizedAccessException or InvalidDataException)
		{
		}
	}

	private void RefreshRecentSetups()
	{
		IReadOnlyList<RecentSetup> setups;
		try
		{
			setups = RecentSetupStore.Load();
		}
		catch (Exception exception) when (
			exception is IOException or UnauthorizedAccessException)
		{
			_recentSetups = [];
			return;
		}

		_recentSetups = setups
			.Select(setup => RecentSetupProjection.Project(
				setup,
				LobbyMetadata,
				Clock.GetUtcNow()))
			.ToArray();
	}

	private void ShowRoleLockIn()
	{
		MoveTo(LobbyStep.RoleLockIn);
	}

	private void ShowActorSetupCards()
	{
		MoveTo(LobbyStep.ActorSetupCards);
	}

	private void ShowPublicGroupPartition()
	{
		MoveTo(LobbyStep.PublicGroupPartition);
	}

	private void ShowLabs()
	{
		MoveTo(LobbyStep.Labs);
	}

	private void HandleLobbyExitOutcome(LobbyExitOutcome outcome)
	{
		switch (outcome)
		{
			case LobbyExitOutcome.ConfigurationRequired configuration:
				MoveTo(configuration.Step switch
				{
					LobbyConfigurationStep.RoleLockIn => LobbyStep.RoleLockIn,
					LobbyConfigurationStep.ActorSetupCards => LobbyStep.ActorSetupCards,
					LobbyConfigurationStep.PublicGroupPartition => LobbyStep.PublicGroupPartition,
					_ => throw new ArgumentOutOfRangeException(nameof(outcome))
				});
				break;
			case LobbyExitOutcome.Started:
				MoveTo(LobbyStep.Dashboard);
				break;
		}
	}

	private void HandleReturnToLobby()
	{
		Game.ClearSession();
		MoveTo(LobbyStep.Roster);
	}

	private void HandleGameStateChanged(object? sender, EventArgs args)
	{
		if (_currentStep == LobbyStep.Dashboard &&
			Game.CurrentInstruction is FinishedGameConfirmationInstruction finished)
		{
			_gameResult = finished.GameResult;
			_victoryCheckWindow = finished.VictoryCheckWindow;
			MoveTo(LobbyStep.Victory);
			_ = InvokeAsync(StateHasChanged);
		}
	}

	private void MoveTo(LobbyStep step)
	{
		_currentStep = step;
		WakeLock.MoveTo(step switch
		{
				LobbyStep.Roster or LobbyStep.RoleSelection or LobbyStep.RoleLockIn or
					LobbyStep.ActorSetupCards or
					LobbyStep.PublicGroupPartition => GameplayWakeLockArea.Lobby,
			LobbyStep.Dashboard => GameplayWakeLockArea.Dashboard,
			_ => GameplayWakeLockArea.None
		});
	}

	public void Dispose()
	{
		Game.StateChanged -= HandleGameStateChanged;
		WakeLock.MoveTo(GameplayWakeLockArea.None);
	}

	private enum LobbyStep
	{
			Landing,
			Roster,
			RoleSelection,
			RoleLockIn,
			ActorSetupCards,
			PublicGroupPartition,
			Labs,
		Dashboard,
		Victory
	}
}
