@inject LobbySetupState Lobby
@inject GameClientManager Game

<main class="ww-app-shell" aria-labelledby="roster-title">
	<section class="ww-lobby-header">
		<div>
			<p class="ww-step-label">@ClientStrings.LobbyRoster_StepLabel</p>
			<h1 id="roster-title">@ClientStrings.LobbyRoster_Title</h1>
			<p class="ww-page-copy">@ClientStrings.LobbyRoster_Description</p>
		</div>
		<div class="ww-roster-count @(HasEnoughPlayers ? "" : "ww-roster-count--under")" aria-label="@PlayerCountLabel">
			@Lobby.PlayerNames.Count@if (!HasEnoughPlayers)
			{<span class="ww-roster-count__min">&thinsp;/&thinsp;@MinPlayers</span>}
		</div>
	</section>

	<form class="ww-roster-form" @onsubmit="AddPlayer" @onsubmit:preventDefault="true">
		<label for="player-name">@ClientStrings.LobbyRoster_PlayerNameLabel</label>
		<div class="ww-add-row">
			<input id="player-name"
				   type="text"
				   autocomplete="off"
				   placeholder="@ClientStrings.LobbyRoster_PlayerNamePlaceholder"
				   @bind="_draftPlayerName"
				   @bind:event="oninput" />
			<button type="submit">@ClientStrings.LobbyRoster_AddButton</button>
		</div>
		@if (_validationMessage is not null)
		{
			<p class="ww-validation" role="alert">@_validationMessage</p>
		}
	</form>

	<section class="ww-roster-panel" aria-label="@ClientStrings.LobbyRoster_SeatOrderLabel">
		<div class="ww-section-head">
			<span>@ClientStrings.LobbyRoster_SeatOrderLabel</span>
			<span>@PlayerCountLabel</span>
		</div>

		@if (Lobby.PlayerNames.Count == 0)
		{
			<p class="ww-empty-state">@ClientStrings.LobbyRoster_EmptyState</p>
		}
		else
		{
			<ol class="ww-roster-list">
				@for (var index = 0; index < Lobby.PlayerNames.Count; index++)
				{
					var seatIndex = index;
					var playerName = Lobby.PlayerNames[seatIndex];
					var rowKey = $"{seatIndex}:{playerName}";

					<li class="ww-roster-item" @key="rowKey">
						<div class="ww-seat-number">@(seatIndex + 1)</div>
						<div class="ww-player-name">@playerName</div>
						<div class="ww-row-actions">
							<button type="button"
									class="ww-icon-button"
									title="@ClientStrings.LobbyRoster_MoveUpTitle"
									aria-label="@Format(ClientStrings.LobbyRoster_MoveUpAriaFormat, playerName)"
									disabled="@(!Lobby.CanMovePlayerUp(seatIndex))"
									@onclick="() => MovePlayerUp(seatIndex)">↑</button>
							<button type="button"
									class="ww-icon-button"
									title="@ClientStrings.LobbyRoster_MoveDownTitle"
									aria-label="@Format(ClientStrings.LobbyRoster_MoveDownAriaFormat, playerName)"
									disabled="@(!Lobby.CanMovePlayerDown(seatIndex))"
									@onclick="() => MovePlayerDown(seatIndex)">↓</button>
							<button type="button"
									class="ww-icon-button ww-icon-button-danger"
									title="@ClientStrings.LobbyRoster_RemoveTitle"
									aria-label="@Format(ClientStrings.LobbyRoster_RemoveAriaFormat, playerName)"
									@onclick="() => RemovePlayer(seatIndex)">×</button>
						</div>
					</li>
				}
			</ol>
		}
	</section>

	<footer class="ww-action-bar">
		@if (_rosterErrors.Count > 0)
		{
			<ul class="ww-validation" role="alert">
				@foreach (var error in _rosterErrors)
				{
					<li>@error</li>
				}
			</ul>
		}
		@if (IsDebugBuild && OnShowLabs.HasDelegate)
		{
			<div class="ww-action-pair">
				<button type="button" class="ww-secondary-button" @onclick="ShowLabs">@ClientStrings.Common_Labs</button>
				<button type="button" class="ww-btn-primary" disabled="@(!HasEnoughPlayers)" @onclick="Continue">@ClientStrings.LobbyRoster_ContinueToRolesButton</button>
			</div>
		}
		else
		{
			<button type="button" class="ww-btn-primary" disabled="@(!HasEnoughPlayers)" @onclick="Continue">@ClientStrings.LobbyRoster_ContinueToRolesButton</button>
		}
	</footer>
</main>

@using Werewolves.Core.StateModels.Extensions
@using Werewolves.Core.StateModels.Models

@code {
	[Parameter]
	public EventCallback OnContinue { get; set; }

	[Parameter]
	public EventCallback OnShowLabs { get; set; }

	private string _draftPlayerName = string.Empty;
	private string? _validationMessage;
	private List<string> _rosterErrors = new();

#if DEBUG
	private const bool IsDebugBuild = true;
#else
	private const bool IsDebugBuild = false;
#endif

	private int MinPlayers => Lobby.MinimumPlayerCount;
	private bool HasEnoughPlayers => Lobby.PlayerNames.Count >= MinPlayers;

	private string PlayerCountLabel => Lobby.PlayerNames.Count == 1
		? ClientStrings.LobbyRoster_PlayerCountOne
		: Format(ClientStrings.LobbyRoster_PlayerCountManyFormat, Lobby.PlayerNames.Count);

	private void AddPlayer()
	{
		var added = Game.TryAddStagedPlayer(
			Lobby,
			_draftPlayerName,
			out var result);
		if (added)
		{
			_draftPlayerName = string.Empty;
			_validationMessage = null;
			_rosterErrors.Clear();
			return;
		}

		_validationMessage = result switch
		{
			AddPlayerResult.EmptyName => ClientStrings.Validation_EmptyPlayerName,
			AddPlayerResult.DuplicateName => ClientStrings.Validation_DuplicatePlayerName,
			_ => null
		};
	}

	private void MovePlayerUp(int index)
	{
		Game.TryMoveStagedPlayerUp(Lobby, index);
	}

	private void MovePlayerDown(int index)
	{
		Game.TryMoveStagedPlayerDown(Lobby, index);
	}

	private void RemovePlayer(int index)
	{
		if (Game.TryRemoveStagedPlayer(Lobby, index))
		{
			_rosterErrors.Clear();
		}
	}

	private Task Continue()
	{
		if (Lobby.HasPlayerConfigIssues(out var issues))
		{
			_rosterErrors = issues.Select(GameConfigValidationExtensions.GetDisplayMessage).ToList();
			return Task.CompletedTask;
		}

		_rosterErrors.Clear();
		return OnContinue.InvokeAsync();
	}

	private Task ShowLabs() => OnShowLabs.InvokeAsync();

	private static string Format(string format, params object[] args) =>
		string.Format(CultureInfo.CurrentCulture, format, args);

}
