@implements IDisposable
@inject GameClientManager Game

<main class="ww-dashboard-shell" data-production-dashboard data-testid="@ModeratorUiTestIds.DashboardShell" aria-label="@DashboardStatusLabel">
	<nav class="ww-dashboard-tabs ww-dashboard-tabs--compact" data-testid="@ModeratorUiTestIds.DashboardCompactTabs" aria-label="@ClientStrings.Dashboard_TabsAria">
		<button type="button"
				class="@TabButtonClass(DashboardTab.Roster)"
				aria-selected="@AriaSelected(DashboardTab.Roster)"
				@onclick="() => SelectTab(DashboardTab.Roster)">@ClientStrings.Dashboard_TabRoster</button>
		<button type="button"
				class="@TabButtonClass(DashboardTab.Action)"
				aria-selected="@AriaSelected(DashboardTab.Action)"
				@onclick="() => SelectTab(DashboardTab.Action)">@ClientStrings.Dashboard_TabAction</button>
		<button type="button"
				class="@TabButtonClass(DashboardTab.Stats)"
				aria-selected="@AriaSelected(DashboardTab.Stats)"
				@onclick="() => SelectTab(DashboardTab.Stats)">@ClientStrings.Dashboard_TabStats</button>
	</nav>

	<header class="ww-labs-status-bar ww-dashboard-status-bar" data-testid="@ModeratorUiTestIds.DashboardStatusBar" aria-label="@DashboardStatusLabel">
		<span class="ww-labs-status-bar__dot" aria-hidden="true"></span>
		<span class="ww-labs-status-bar__turn">@PhaseTurnLabel</span>
		<span class="ww-labs-status-bar__phase">@Format(ClientStrings.Dashboard_AliveCountFormat, AliveCount)</span>
		<button type="button"
				class="@AudioToggleClass"
				aria-label="@AudioToggleLabel"
				title="@AudioToggleLabel"
				aria-pressed="@AudioTogglePressed"
				@onclick="ToggleAudioMute">
			@if (Game.IsAudioMuted)
			{
				<svg class="ww-audio-toggle__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M11 5 6 9H3v6h3l5 4z" />
					<path d="m16 9 5 5" />
					<path d="m21 9-5 5" />
				</svg>
			}
			else
			{
				<svg class="ww-audio-toggle__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M11 5 6 9H3v6h3l5 4z" />
					<path d="M16 8a5 5 0 0 1 0 8" />
					<path d="M19 5a9 9 0 0 1 0 14" />
				</svg>
			}
		</button>
	</header>

	<section class="ww-dashboard-panel" style="@PanelStyle(DashboardTab.Roster)" aria-hidden="@(_activeTab != DashboardTab.Roster)">
		<div class="ww-section-head">
			<span>@ClientStrings.Dashboard_PlayerStatusLabel</span>
			<span>@PlayerCountLabel</span>
		</div>

		@if (RosterEntries.Count == 0)
		{
			<p class="ww-empty-state">@ClientStrings.Dashboard_EmptyRoster</p>
		}
		else
		{
			<ol class="ww-dashboard-roster">
				@for (var index = 0; index < RosterEntries.Count; index++)
				{
					var player = RosterEntries[index];
					<li class="ww-dashboard-player @(player.IsDead ? "ww-dashboard-player--dead" : "")" @key="player.PlayerId">
						<span class="ww-seat-number">@player.SeatNumber</span>
						<div class="ww-dashboard-player__main">
							<span class="ww-player-name">@player.Name</span>
							<span class="ww-dashboard-player__meta">@player.RoleLabel · @player.HealthLabel</span>
						</div>
						<span class="ww-status-list">@StatusEffectsLabel(player)</span>
					</li>
				}
			</ol>
		}
	</section>

	<section class="ww-dashboard-panel ww-action-panel" style="@PanelStyle(DashboardTab.Action)" aria-hidden="@(_activeTab != DashboardTab.Action)">
		@if (Game.DebateElapsed is { } debateElapsed)
		{
			<div class="ww-debate-timer" aria-label="@ClientStrings.Dashboard_DebateTimerLabel">
				<span class="ww-label">@ClientStrings.Dashboard_DebateTimerLabel</span>
				<span class="ww-debate-timer__clock">@FormatElapsed(debateElapsed)</span>
			</div>
		}
		<InstructionRenderer Instruction="Game.CurrentInstruction" Roster="RosterEntries" OnResponse="ProcessResponse" />
	</section>

	<section class="ww-dashboard-panel" style="@PanelStyle(DashboardTab.Stats)" aria-hidden="@(_activeTab != DashboardTab.Stats)">
		@{
			var stats = StatsSnapshot;
		}
		<div class="ww-section-head">
			<span>@ClientStrings.Dashboard_GameSummaryLabel</span>
			<span>@PhaseTurnLabel</span>
		</div>

		<div class="ww-stats-grid">
			<div class="ww-stat-tile">
				<span class="ww-label">@ClientStrings.Dashboard_AliveStatLabel</span>
				<strong>@AliveCount</strong>
			</div>
			<div class="ww-stat-tile">
				<span class="ww-label">@ClientStrings.Dashboard_EliminatedStatLabel</span>
				<strong>@EliminatedCount</strong>
			</div>
			<div class="ww-stat-tile">
				<span class="ww-label">@ClientStrings.Dashboard_RevealedStatLabel</span>
				<strong>@KnownAliveRoleCount</strong>
			</div>
		</div>

		<section class="ww-stats-section" aria-labelledby="roles-remaining-title">
			<div class="ww-section-head">
				<span id="roles-remaining-title">@ClientStrings.Dashboard_RolesByFactionTitle</span>
				<span>@KnownAliveRoleCountLabel(stats)</span>
			</div>

			<div class="ww-faction-summary">
				@foreach (var group in stats.RoleGroups)
				{
					<article class="ww-faction-summary__group" @key="group.Group">
						<header class="ww-faction-summary__header">
							<span class="ww-faction-badge">
								<span class="ww-faction-badge__dot" style="background: var(@GroupCssVar(group.Group))"></span>
								@group.DisplayName
							</span>
							<strong>@group.RemainingCount</strong>
						</header>

						@if (group.Roles.Count == 0)
						{
							<p class="ww-faction-summary__empty">@ClientStrings.Dashboard_NoRevealedRoles</p>
						}
						else
						{
							<div class="ww-role-summary" aria-label="@Format(ClientStrings.Dashboard_FactionRolesAriaFormat, group.DisplayName)">
								@foreach (var role in group.Roles)
								{
									<div class="ww-role-summary__row" @key="role.Role">
										<span>@role.DisplayName</span>
										<strong>@role.RemainingCount</strong>
									</div>
								}
							</div>
						}
					</article>
				}
			</div>
		</section>

		<section class="ww-stats-section" aria-labelledby="elimination-log-title">
			<div class="ww-section-head">
				<span id="elimination-log-title">@ClientStrings.Dashboard_EliminationLogTitle</span>
				<span>@EliminationLogCountLabel(stats)</span>
			</div>

			@if (stats.EliminationLog.Count == 0)
			{
				<p class="ww-empty-state">@ClientStrings.Dashboard_NoEliminations</p>
			}
			else
			{
				<ol class="ww-elimination-log">
					@foreach (var entry in stats.EliminationLog)
					{
						<li class="ww-elimination-log__entry" @key="@($"{entry.TurnNumber}:{entry.Phase}:{entry.PlayerName}")">
							<span class="ww-elimination-log__phase">@entry.TurnPhaseLabel</span>
							<div class="ww-elimination-log__body">
								<span class="ww-player-name">@entry.PlayerName</span>
								<span class="ww-elimination-log__reason">@entry.ReasonLabel</span>
							</div>
						</li>
					}
				</ol>
			}
		</section>

		<footer class="ww-abandon-game">
			<button type="button"
					class="ww-secondary-button"
					data-testid="@ModeratorUiTestIds.AbandonGameButton"
					@onclick="AbandonGame">@ClientStrings.Dashboard_AbandonGameButton</button>
		</footer>
	</section>
</main>

@using Werewolves.Client.Services
@using Werewolves.Core.StateModels.Core
@using Werewolves.Core.StateModels.Enums
@using Werewolves.Core.StateModels.Extensions
@using Werewolves.Core.StateModels.Models

@code {
	[Parameter]
	public EventCallback OnAbandonGame { get; set; }

	private DashboardTab _activeTab = DashboardTab.Action;
	private Timer? _debateTickTimer;

	protected override void OnInitialized()
	{
		Game.StateChanged += HandleStateChanged;
		SyncDebateTickTimer();
	}

	private IReadOnlyList<IPlayer> Players => Game.CurrentSession?.GetPlayers().ToList() ?? [];
	private IReadOnlyList<DashboardRosterEntry> RosterEntries => Game.CurrentRoster;

	private int AliveCount => Players.Count(player => player.State.Health == PlayerHealth.Alive);
	private int EliminatedCount => Players.Count(player => player.State.Health == PlayerHealth.Dead);
	private int KnownAliveRoleCount => Players.Count(player =>
		player.State.Health == PlayerHealth.Alive &&
		player.State.MainRole is not null);
	private DashboardStatsSnapshot StatsSnapshot => DashboardStatsSnapshot.FromSession(Game.CurrentSession);

	private string PlayerCountLabel => Players.Count == 1
		? ClientStrings.Dashboard_PlayerCountOne
		: Format(ClientStrings.Dashboard_PlayerCountManyFormat, Players.Count);

	private string PhaseTurnLabel
	{
		get
		{
			if (Game.CurrentPhase is not { } phase || Game.TurnNumber is not { } turn)
			{
				return ClientStrings.Dashboard_NoSession;
			}

			return Format(ClientStrings.Dashboard_PhaseTurnFormat, PhaseLabel(phase), turn);
		}
	}

	private string DashboardStatusLabel =>
		$"{PhaseTurnLabel}; {Format(ClientStrings.Dashboard_AliveCountFormat, AliveCount)}";

	private void SelectTab(DashboardTab tab)
	{
		_activeTab = tab;
	}

	private void ProcessResponse(ModeratorResponse response)
	{
		Game.ProcessInput(response);
	}

	private Task ToggleAudioMute() => Game.ToggleAudioMuteAsync();

	private Task AbandonGame() => OnAbandonGame.InvokeAsync();

	private string TabButtonClass(DashboardTab tab) =>
		_activeTab == tab ? "ww-dashboard-tab ww-dashboard-tab--active" : "ww-dashboard-tab";

	private string AriaSelected(DashboardTab tab) => _activeTab == tab ? "true" : "false";

	private string PanelStyle(DashboardTab tab) =>
		_activeTab == tab ? "display:block;" : "display:none;";

	private string AudioToggleLabel => Game.IsAudioMuted
		? ClientStrings.Dashboard_AudioUnmute
		: ClientStrings.Dashboard_AudioMute;

	private string AudioToggleClass => Game.IsAudioMuted
		? "ww-icon-button ww-audio-toggle ww-audio-toggle--muted"
		: "ww-icon-button ww-audio-toggle";

	private string AudioTogglePressed => Game.IsAudioMuted ? "true" : "false";

	private static string PhaseLabel(GamePhase phase) => phase switch
	{
		GamePhase.Night => ClientStrings.Dashboard_PhaseNight,
		GamePhase.Dawn => ClientStrings.Dashboard_PhaseDawn,
		GamePhase.Day => ClientStrings.Dashboard_PhaseDay,
		_ => ClientStrings.Dashboard_PhaseFallback
	};

	private static string StatusEffectsLabel(DashboardRosterEntry player) => player.StatusEffectsLabel;

	private static string KnownAliveRoleCountLabel(DashboardStatsSnapshot stats)
	{
		var count = stats.RoleGroups.Sum(group => group.RemainingCount);
		return count == 1
			? ClientStrings.Dashboard_RevealedRoleCountOne
			: Format(ClientStrings.Dashboard_RevealedRoleCountManyFormat, count);
	}

	private static string EliminationLogCountLabel(DashboardStatsSnapshot stats)
	{
		var count = stats.EliminationLog.Count;
		return count == 1
			? ClientStrings.Dashboard_EliminationCountOne
			: Format(ClientStrings.Dashboard_EliminationCountManyFormat, count);
	}

	private static string GroupCssVar(RoleGroup group) => group switch
	{
		RoleGroup.Villagers => "--ww-faction-villager",
		RoleGroup.Werewolves => "--ww-faction-werewolf",
		RoleGroup.Ambiguous => "--ww-faction-ambiguous",
		RoleGroup.Loners => "--ww-faction-loner",
		_ => "--ww-accent"
	};

	private static string FormatElapsed(TimeSpan elapsed)
	{
		var totalMinutes = (int)elapsed.TotalMinutes;
		var seconds = elapsed.Seconds;
		return $"{totalMinutes:D2}:{seconds:D2}";
	}

	private void HandleStateChanged(object? sender, EventArgs args)
	{
		_ = InvokeAsync(() =>
		{
			SyncDebateTickTimer();
			StateHasChanged();
		});
	}

	private void SyncDebateTickTimer()
	{
		var isDebating = Game.DebateElapsed.HasValue;

		if (isDebating && _debateTickTimer is null)
		{
			_debateTickTimer = new Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
		}
		else if (!isDebating && _debateTickTimer is not null)
		{
			_debateTickTimer.Dispose();
			_debateTickTimer = null;
		}
	}

	public void Dispose()
	{
		Game.StateChanged -= HandleStateChanged;
		_debateTickTimer?.Dispose();
	}

	private enum DashboardTab
	{
		Roster,
		Action,
		Stats
	}

	private static string Format(string format, params object[] args) =>
		string.Format(CultureInfo.CurrentCulture, format, args);
}
