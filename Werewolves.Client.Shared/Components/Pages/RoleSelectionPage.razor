@implements IDisposable
@inject LobbySetupState Lobby
@inject LobbyEvaluationCoordinator Evaluation

<main class="ww-app-shell" aria-labelledby="role-selection-title">
	<section class="ww-lobby-header">
		<div>
			<p class="ww-step-label">@ClientStrings.RoleSelection_StepLabel</p>
			<h1 id="role-selection-title">@ClientStrings.RoleSelection_Title</h1>
			<p class="ww-page-copy">@ClientStrings.RoleSelection_Description</p>
		</div>
		<div class="ww-roster-count @(IsCountMatching ? "" : "ww-roster-count--under")" aria-label="@CountLabel">
			@Lobby.TotalSelectedRoleCount<span class="ww-roster-count__min">&thinsp;/&thinsp;@Lobby.ExpectedRoleCount</span>
		</div>
	</section>

	@foreach (var group in Lobby.AvailableRoleGroups)
	{
		<section class="ww-role-group" aria-label="@group.DisplayName">
			<div class="ww-section-head">
				<span class="ww-faction-badge">
					<span class="ww-faction-badge__dot" style="background: var(@GroupCssVar(group.Group))"></span>
					@group.DisplayName
				</span>
			</div>
			<div class="ww-role-list">
				@foreach (var info in group.Roles)
				{
					var role = info.Role;

					<div class="ww-role-row @(info.Count > 0 ? "ww-role-row--active" : "")" @key="role">
						<span class="ww-role-label">@info.DisplayName</span>
						@if (info.Affordance == RoleAffordance.Stepper)
						{
							<div class="ww-stepper">
								<button type="button"
										class="ww-stepper-btn"
										aria-label="@Format(ClientStrings.RoleSelection_RemoveRoleAriaFormat, info.DisplayName)"
										disabled="@(!info.CanDecrement)"
										@onclick="() => DecrementRole(role)">−</button>
								<span class="ww-stepper-count" aria-label="@Format(ClientStrings.RoleSelection_RoleCountAriaFormat, info.Count, info.DisplayName)">@info.Count</span>
								<button type="button"
										class="ww-stepper-btn"
										aria-label="@Format(ClientStrings.RoleSelection_AddRoleAriaFormat, info.DisplayName)"
										@onclick="() => IncrementRole(role)">+</button>
							</div>
						}
						else
						{
							<button type="button"
									class="ww-toggle @(info.Count > 0 ? "ww-toggle--on" : "")"
									aria-pressed="@(info.Count > 0)"
									aria-label="@info.DisplayName"
									@onclick="() => ToggleRole(role)">
								@if (info.Count > 0 && info.BatchSize <= 1)
								{
									<span>&#x2713;</span>
								}
								else if (info.BatchSize > 1)
								{
									<span class="ww-toggle__batch">@("×")@info.BatchSize</span>
								}
							</button>
						}
					</div>
				}
			</div>
		</section>
	}

	<LobbyEvaluationPanel State="@_evaluationState" OnRetry="RetryEvaluation" />

	<footer class="ww-action-bar" data-testid="@ModeratorUiTestIds.RoleSelectionActionBar">
		@if (_validationErrors.Count > 0)
		{
			<ul class="ww-validation ww-validation--role" role="alert">
				@foreach (var error in _validationErrors)
				{
					<li>@error</li>
				}
			</ul>
		}
		@if (!string.IsNullOrEmpty(_blockAnnouncement))
		{
			<p class="ww-lobby-evaluation__status"
			   data-testid="@ModeratorUiTestIds.LobbyEvaluationStatus"
			   role="status"
			   aria-live="polite">@_blockAnnouncement</p>
		}
		<div class="ww-action-pair">
			<button type="button" class="ww-secondary-button" @onclick="Back">@ClientStrings.Common_Back</button>
			<button type="button"
					class="ww-btn-primary"
					data-testid="@ModeratorUiTestIds.RoleSelectionStartGame"
					disabled="@(!CanStartGame)"
					@onclick="StartGame">@ClientStrings.RoleSelection_StartGameButton</button>
		</div>
	</footer>
</main>

@using Werewolves.Core.StateModels.Enums
@using Werewolves.Core.StateModels.Extensions
@using Werewolves.Client.Testing

@code {
	[Parameter]
	public EventCallback OnBack { get; set; }

	[Parameter]
	public EventCallback OnStartGame { get; set; }

	private List<string> _validationErrors = new();
	private LobbyEvaluationState _evaluationState = LobbyEvaluationState.NotApplicable();
	private string _blockAnnouncement = string.Empty;

	protected override void OnInitialized()
	{
		Evaluation.StateChanged += HandleEvaluationStateChanged;
		_evaluationState = Evaluation.State;
		RefreshValidation();
	}

	private bool IsCountMatching => Lobby.TotalSelectedRoleCount == Lobby.ExpectedRoleCount;
	private bool CanStartGame => !Lobby.HasRoleConfigIssues(out _);

	private string CountLabel => Format(
		ClientStrings.RoleSelection_SelectedCountFormat,
		Lobby.TotalSelectedRoleCount,
		Lobby.ExpectedRoleCount);

	private void IncrementRole(MainRoleType role)
	{
		Lobby.IncrementRole(role);
		RefreshValidation();
	}

	private void DecrementRole(MainRoleType role)
	{
		Lobby.DecrementRole(role);
		RefreshValidation();
	}

	private void ToggleRole(MainRoleType role)
	{
		if (Lobby.GetRoleCount(role) > 0)
			Lobby.DecrementRole(role);
		else
			Lobby.IncrementRole(role);
		RefreshValidation();
	}

	private void RefreshValidation()
	{
		if (Lobby.HasRoleConfigIssues(out var issues))
		{
			_validationErrors = issues.Select(GameConfigValidationExtensions.GetDisplayMessage).ToList();
		}
		else
		{
			_validationErrors.Clear();
		}
	}

	private Task Back() => OnBack.InvokeAsync();

	private Task StartGame()
	{
		if (Lobby.HasRoleConfigIssues(out var issues))
		{
			_validationErrors = issues.Select(GameConfigValidationExtensions.GetDisplayMessage).ToList();
			return Task.CompletedTask;
		}

		_validationErrors.Clear();
		if (!Evaluation.TryRequestLobbyExit())
		{
			_evaluationState = Evaluation.State;
			_blockAnnouncement = BlockAnnouncement(_evaluationState.Kind);
			return Task.CompletedTask;
		}

		_blockAnnouncement = string.Empty;
		return OnStartGame.InvokeAsync();
	}

	private void RetryEvaluation() => Evaluation.RetryCurrent();

	private void HandleEvaluationStateChanged(object? sender, EventArgs args)
	{
		_ = InvokeAsync(() =>
		{
			_evaluationState = Evaluation.State;
			_blockAnnouncement = string.Empty;
			StateHasChanged();
		});
	}

	private static string BlockAnnouncement(LobbyEvaluationStateKind kind) => kind switch
	{
		LobbyEvaluationStateKind.Pending => ClientStrings.LobbyEvaluation_PendingBlock,
		LobbyEvaluationStateKind.AlreadyDecided => ClientStrings.LobbyEvaluation_AlreadyDecidedBlock,
		LobbyEvaluationStateKind.Degenerate => ClientStrings.LobbyEvaluation_DegenerateBlock,
		_ => ClientStrings.LobbyEvaluation_Blocked
	};

	public void Dispose() => Evaluation.StateChanged -= HandleEvaluationStateChanged;

	private static string GroupCssVar(RoleGroup group) => group switch
	{
		RoleGroup.Villagers => "--ww-faction-villager",
		RoleGroup.Werewolves => "--ww-faction-werewolf",
		RoleGroup.Ambiguous => "--ww-faction-ambiguous",
		RoleGroup.Loners => "--ww-faction-loner",
		RoleGroup.NewMoon => "--ww-accent",
		_ => "--ww-accent"
	};

	private static string Format(string format, params object[] args) =>
		string.Format(CultureInfo.CurrentCulture, format, args);
}
