@inject BenchmarkClientManager Benchmark

<main class="ww-app-shell" aria-labelledby="benchmark-title">
	<section class="ww-lobby-header">
		<div>
			<p class="ww-step-label">@ClientStrings.Benchmark_StepLabel</p>
			<h1 id="benchmark-title">@ClientStrings.Benchmark_Title</h1>
			<p class="ww-page-copy">@ClientStrings.Benchmark_Description</p>
		</div>
		<div class="ww-roster-count" aria-label="@RunCountLabel">@ClientStrings.Benchmark_RunCountPill</div>
	</section>

	<section class="ww-benchmark-panel" aria-label="@ClientStrings.Benchmark_ResultsAria">
		@if (Benchmark.LastResult is null && !Benchmark.IsRunning && _errorMessage is null)
		{
			<p class="ww-empty-state">@ClientStrings.Benchmark_NoResults</p>
		}

		@if (Benchmark.IsRunning)
		{
			<p class="ww-empty-state">@ClientStrings.Benchmark_RunningStatus</p>
		}

		@if (_errorMessage is not null)
		{
			<p class="ww-validation" role="alert">@_errorMessage</p>
		}

		@if (Benchmark.LastResult is { } result)
		{
			<div class="ww-stats-grid ww-benchmark-grid">
				<div class="ww-stat-tile">
					<span class="ww-label">@ClientStrings.Benchmark_TotalLabel</span>
					<strong>@FormatDuration(result.TotalElapsed)</strong>
				</div>
				<div class="ww-stat-tile">
					<span class="ww-label">@ClientStrings.Benchmark_AverageLabel</span>
					<strong>@FormatDuration(result.AverageElapsedPerGame)</strong>
				</div>
				<div class="ww-stat-tile">
					<span class="ww-label">@ClientStrings.Benchmark_GameCountLabel</span>
					<strong>@result.GameCount</strong>
				</div>
				<div class="ww-stat-tile">
					<span class="ww-label">@ClientStrings.Benchmark_DegreeOfParallelismLabel</span>
					<strong>@result.DegreeOfParallelism</strong>
				</div>
				<div class="ww-stat-tile">
					<span class="ww-label">@ClientStrings.Benchmark_MinLabel</span>
					<strong>@FormatDuration(result.MinElapsedPerGame)</strong>
				</div>
				<div class="ww-stat-tile">
					<span class="ww-label">@ClientStrings.Benchmark_MaxLabel</span>
					<strong>@FormatDuration(result.MaxElapsedPerGame)</strong>
				</div>
				<div class="ww-stat-tile">
					<span class="ww-label">@ClientStrings.Benchmark_TurnsLabel</span>
					<strong>@TurnSummary(result.TurnCounts)</strong>
				</div>
			</div>

			<section class="ww-role-summary" aria-label="@ClientStrings.Benchmark_TurnDistributionAria">
				@foreach (var bucket in TurnDistribution(result.TurnCounts))
				{
					<div class="ww-role-summary__row" @key="bucket.TurnCount">
						<span>@Format(ClientStrings.Benchmark_TurnCountFormat, bucket.TurnCount)</span>
						<strong>@bucket.GameCount</strong>
					</div>
				}
			</section>

			<section class="ww-role-summary" aria-label="@ClientStrings.Benchmark_GcCollectionsAria">
				<div class="ww-role-summary__row">
					<span>@ClientStrings.Benchmark_Gen0Label</span>
					<strong>@result.GcCollections.Gen0</strong>
				</div>
				<div class="ww-role-summary__row">
					<span>@ClientStrings.Benchmark_Gen1Label</span>
					<strong>@result.GcCollections.Gen1</strong>
				</div>
				<div class="ww-role-summary__row">
					<span>@ClientStrings.Benchmark_Gen2Label</span>
					<strong>@result.GcCollections.Gen2</strong>
				</div>
			</section>
		}
	</section>

	<footer class="ww-action-bar">
		<div class="ww-action-pair">
			<button type="button" class="ww-secondary-button" @onclick="Back" disabled="@Benchmark.IsRunning">@ClientStrings.Benchmark_BackButton</button>
			<button type="button" class="ww-btn-primary" @onclick="RunBenchmark" disabled="@Benchmark.IsRunning">
				@(Benchmark.IsRunning ? ClientStrings.Benchmark_RunningButton : ClientStrings.Benchmark_RunButton)
			</button>
		</div>
	</footer>
</main>

@using Werewolves.Core.GameLogic.Models

@code {
	[Parameter]
	public EventCallback OnBack { get; set; }

	private string? _errorMessage;
	private string RunCountLabel => ClientStrings.Benchmark_RunCountLabel;

	private async Task RunBenchmark()
	{
		_errorMessage = null;

		try
		{
			var benchmarkTask = Benchmark.RunAsync();
			await InvokeAsync(StateHasChanged);
			await benchmarkTask;
		}
		catch (Exception exception)
		{
			_errorMessage = exception.Message;
		}
	}

	private Task Back() => OnBack.InvokeAsync();

	private static string FormatDuration(TimeSpan elapsed)
	{
		return elapsed.TotalSeconds >= 1
			? Format(ClientStrings.Benchmark_DurationSecondsFormat, elapsed.TotalSeconds)
			: Format(ClientStrings.Benchmark_DurationMillisecondsFormat, elapsed.TotalMilliseconds);
	}

	private static string TurnSummary(IReadOnlyList<int> turnCounts)
	{
		if (turnCounts.Count == 0)
		{
			return ClientStrings.Common_NotAvailable;
		}

		return Format(ClientStrings.Benchmark_TurnSummaryRangeFormat, turnCounts.Min(), turnCounts.Max());
	}

	private static IEnumerable<(int TurnCount, int GameCount)> TurnDistribution(IReadOnlyList<int> turnCounts)
	{
		return turnCounts
			.GroupBy(turnCount => turnCount)
			.OrderBy(group => group.Key)
			.Select(group => (group.Key, group.Count()));
	}

	private static string Format(string format, params object[] args) =>
		string.Format(CultureInfo.CurrentCulture, format, args);
}
