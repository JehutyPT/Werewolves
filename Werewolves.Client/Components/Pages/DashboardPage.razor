@implements IDisposable
@inject GameClientManager Game

<main class="ww-dashboard-shell" aria-labelledby="dashboard-title">
	<nav class="ww-dashboard-tabs" aria-label="@ClientStrings.Dashboard_TabsAria">
		<button type="button"
				class="@TabButtonClass(DashboardTab.Roster)"
				aria-selected="@(_activeTab == DashboardTab.Roster)"
				@onclick="() => SelectTab(DashboardTab.Roster)">@ClientStrings.Dashboard_TabRoster</button>
		<button type="button"
				class="@TabButtonClass(DashboardTab.Action)"
				aria-selected="@(_activeTab == DashboardTab.Action)"
				@onclick="() => SelectTab(DashboardTab.Action)">@ClientStrings.Dashboard_TabAction</button>
		<button type="button"
				class="@TabButtonClass(DashboardTab.Stats)"
				aria-selected="@(_activeTab == DashboardTab.Stats)"
				@onclick="() => SelectTab(DashboardTab.Stats)">@ClientStrings.Dashboard_TabStats</button>
	</nav>

	<header class="ww-phase-strip">
		<div>
			<p class="ww-step-label">@ClientStrings.Dashboard_StepLabel</p>
			<h1 id="dashboard-title">@PhaseTurnLabel</h1>
		</div>
		<span class="ww-phase-pill">@Format(ClientStrings.Dashboard_AliveCountFormat, AliveCount)</span>
	</header>

	<section class="ww-dashboard-panel" style="@PanelStyle(DashboardTab.Roster)" aria-hidden="@(_activeTab != DashboardTab.Roster)">
		<div class="ww-section-head">
			<span>@ClientStrings.LobbyRoster_SeatOrderLabel</span>
			<span>@PlayerCountLabel</span>
		</div>

		@if (Players.Count == 0)
		{
			<p class="ww-empty-state">@ClientStrings.Dashboard_EmptyRoster</p>
		}
		else
		{
			<ol class="ww-dashboard-roster">
				@for (var index = 0; index < Players.Count; index++)
				{
					var player = Players[index];
					<li class="ww-dashboard-player @(player.State.Health == PlayerHealth.Dead ? "ww-dashboard-player--dead" : "")" @key="player.Id">
						<span class="ww-seat-number">@(index + 1)</span>
						<div class="ww-dashboard-player__main">
							<span class="ww-player-name">@player.Name</span>
							<span class="ww-dashboard-player__meta">@RoleLabel(player) · @HealthLabel(player.State.Health)</span>
						</div>
						<span class="ww-status-list">@StatusEffectsLabel(player)</span>
					</li>
				}
			</ol>
		}
	</section>

	<section class="ww-dashboard-panel ww-action-panel" style="@PanelStyle(DashboardTab.Action)" aria-hidden="@(_activeTab != DashboardTab.Action)">
		<div class="ww-instruction-stack">
			@if (Game.CurrentInstruction is null)
			{
				<p class="ww-empty-state">@ClientStrings.Dashboard_NoInstruction</p>
			}
			else
			{
				@if (!string.IsNullOrWhiteSpace(Game.CurrentInstruction.PublicAnnouncement))
				{
					<article class="ww-instruction-block">
						<span class="ww-label ww-label--accent">@ClientStrings.Dashboard_AnnounceLabel</span>
						<p class="ww-announcement">@Game.CurrentInstruction.PublicAnnouncement</p>
					</article>
				}

				@if (!string.IsNullOrWhiteSpace(Game.CurrentInstruction.PrivateInstruction))
				{
					<article class="ww-instruction-block">
						<span class="ww-label">@ClientStrings.Dashboard_ModeratorLabel</span>
						<p>@Game.CurrentInstruction.PrivateInstruction</p>
					</article>
				}
			}
		</div>

		<footer class="ww-dashboard-action-zone">
			@if (Game.CurrentInstruction is ConfirmationInstruction confirmationInstruction)
			{
				<button type="button" class="ww-btn-primary" @onclick="() => Confirm(confirmationInstruction)">@ClientStrings.Dashboard_ContinueButton</button>
			}
			else
			{
				<button type="button" class="ww-btn-primary" disabled>@ClientStrings.Dashboard_RespondButton</button>
			}
		</footer>
	</section>

	<section class="ww-dashboard-panel" style="@PanelStyle(DashboardTab.Stats)" aria-hidden="@(_activeTab != DashboardTab.Stats)">
		<div class="ww-section-head">
			<span>@ClientStrings.Dashboard_GameSummaryLabel</span>
			<span>@PhaseTurnLabel</span>
		</div>

		<div class="ww-stats-grid">
			<div class="ww-stat-tile">
				<span class="ww-label">@ClientStrings.Dashboard_AliveStatLabel</span>
				<strong>@AliveCount</strong>
			</div>
			<div class="ww-stat-tile">
				<span class="ww-label">@ClientStrings.Dashboard_EliminatedStatLabel</span>
				<strong>@EliminatedCount</strong>
			</div>
			<div class="ww-stat-tile">
				<span class="ww-label">@ClientStrings.Dashboard_RolesStatLabel</span>
				<strong>@RoleCount</strong>
			</div>
		</div>

		<section class="ww-role-summary" aria-label="@ClientStrings.Dashboard_RolesInPlayAria">
			@foreach (var role in RolesInPlay)
			{
				<div class="ww-role-summary__row" @key="role.Role">
					<span>@role.Name</span>
					<strong>@role.Count</strong>
				</div>
			}
		</section>
	</section>
</main>

@using Werewolves.Client.Services
@using Werewolves.Core.StateModels.Core
@using Werewolves.Core.StateModels.Enums
@using Werewolves.Core.StateModels.Extensions
@using Werewolves.Core.StateModels.Models.Instructions

@code {
	private DashboardTab _activeTab = DashboardTab.Action;

	protected override void OnInitialized()
	{
		Game.StateChanged += HandleStateChanged;
	}

	private IReadOnlyList<IPlayer> Players => Game.CurrentSession?.GetPlayers().ToList() ?? [];

	private int AliveCount => Players.Count(player => player.State.Health == PlayerHealth.Alive);
	private int EliminatedCount => Players.Count(player => player.State.Health == PlayerHealth.Dead);
	private int RoleCount => Players.Count(player => player.State.MainRole is not null);

	private string PlayerCountLabel => Players.Count == 1
		? ClientStrings.Dashboard_PlayerCountOne
		: Format(ClientStrings.Dashboard_PlayerCountManyFormat, Players.Count);

	private string PhaseTurnLabel
	{
		get
		{
			if (Game.CurrentPhase is not { } phase || Game.TurnNumber is not { } turn)
			{
				return ClientStrings.Dashboard_NoSession;
			}

			return Format(ClientStrings.Dashboard_PhaseTurnFormat, PhaseLabel(phase), turn);
		}
	}

	private IEnumerable<(MainRoleType Role, string Name, int Count)> RolesInPlay =>
		Players
			.Select(player => player.State.MainRole)
			.OfType<MainRoleType>()
			.GroupBy(role => role)
			.OrderBy(group => group.Key.GetRoleGroup())
			.ThenBy(group => group.Key.GetPublicName())
			.Select(group => (group.Key, group.Key.GetPublicName(), group.Count()));

	private void SelectTab(DashboardTab tab)
	{
		_activeTab = tab;
	}

	private void Confirm(ConfirmationInstruction instruction)
	{
		Game.ProcessInput(instruction.CreateResponse(true));
	}

	private string TabButtonClass(DashboardTab tab) =>
		_activeTab == tab ? "ww-dashboard-tab ww-dashboard-tab--active" : "ww-dashboard-tab";

	private string PanelStyle(DashboardTab tab) =>
		_activeTab == tab ? "display:block;" : "display:none;";

	private static string PhaseLabel(GamePhase phase) => phase switch
	{
		GamePhase.Night => ClientStrings.Dashboard_PhaseNight,
		GamePhase.Dawn => ClientStrings.Dashboard_PhaseDawn,
		GamePhase.Day => ClientStrings.Dashboard_PhaseDay,
		_ => ClientStrings.Dashboard_PhaseFallback
	};

	private static string RoleLabel(IPlayer player) =>
		player.State.MainRole?.GetPublicName() ?? ClientStrings.Dashboard_UnassignedRole;

	private static string HealthLabel(PlayerHealth health) => health switch
	{
		PlayerHealth.Alive => ClientStrings.Dashboard_HealthAlive,
		PlayerHealth.Dead => ClientStrings.Dashboard_HealthDead,
		_ => ClientStrings.Dashboard_HealthUnknown
	};

	private static string StatusEffectsLabel(IPlayer player)
	{
		var effects = player.State.GetActiveStatusEffects();
		return effects.Count == 0
			? ClientStrings.Dashboard_NoStatusEffects
			: string.Join(ClientStrings.Common_ListSeparator, effects.Select(StatusEffectLabel));
	}

	private static string StatusEffectLabel(StatusEffectTypes effect) => effect switch
	{
		StatusEffectTypes.ElderProtectionLost => ClientStrings.StatusEffect_ElderProtectionLost,
		StatusEffectTypes.LycanthropyInfection => ClientStrings.StatusEffect_LycanthropyInfection,
		StatusEffectTypes.WildChildChanged => ClientStrings.StatusEffect_WildChildChanged,
		StatusEffectTypes.LynchingImmunityUsed => ClientStrings.StatusEffect_LynchingImmunityUsed,
		StatusEffectTypes.Sheriff => ClientStrings.StatusEffect_Sheriff,
		StatusEffectTypes.Lovers => ClientStrings.StatusEffect_Lovers,
		StatusEffectTypes.Charmed => ClientStrings.StatusEffect_Charmed,
		StatusEffectTypes.TownCrier => ClientStrings.StatusEffect_TownCrier,
		StatusEffectTypes.Executioner => ClientStrings.StatusEffect_Executioner,
		_ => ClientStrings.StatusEffect_Fallback
	};

	private void HandleStateChanged(object? sender, EventArgs args)
	{
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		Game.StateChanged -= HandleStateChanged;
	}

	private enum DashboardTab
	{
		Roster,
		Action,
		Stats
	}

	private static string Format(string format, params object[] args) =>
		string.Format(CultureInfo.CurrentCulture, format, args);
}
