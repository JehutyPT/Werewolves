@using Werewolves.Client.Components.Pages
@implements IDisposable
@inject AppRouteState RouteState
@inject LobbySetupState Lobby

@if (RouteState.CurrentScreen == AppScreen.Roster)
{
	<LobbyRosterPage OnContinue="ShowRoleSelection" />
}
else if (RouteState.CurrentScreen == AppScreen.RoleSelection)
{
	<RoleSelectionPage OnBack="ShowRoster" OnStartGame="HandleStartGame" />
}
else
{
	<DashboardPage />
}

@code {
	protected override void OnInitialized()
	{
		RouteState.StateChanged += OnRouteStateChanged;
	}

	private void ShowRoleSelection()
	{
		RouteState.ShowRoleSelection();
	}

	private void ShowRoster()
	{
		RouteState.ShowRoster();
	}

	private void HandleStartGame()
	{
		RouteState.StartGame(Lobby);
	}

	private void OnRouteStateChanged()
	{
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		RouteState.StateChanged -= OnRouteStateChanged;
	}
}
