<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Werewolves.Client"
             x:Class="Werewolves.Client.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="WerewolvesBackground">#070C12</Color>
            <Color x:Key="WerewolvesText">#EAF4FB</Color>
            <Color x:Key="WerewolvesAccent">#3FE0C8</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource WerewolvesBackground}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
