@using Werewolves.Client.Components
@implements IDisposable
@inject NavigationManager Navigation
@inject LobbySetupState Lobby
@inject GameClientManager Game
@inject LobbyEvaluationCoordinator Evaluation

<Routes />
<output data-testid="browser-qa-evaluation-state"
		data-state="@Evaluation.State.Kind"
		hidden
		aria-hidden="true">@Evaluation.State.Kind</output>

@code {
	protected override void OnInitialized()
	{
		BrowserQaScenarioSeeder.Apply(
			BrowserQaScenarioSelection.FromUri(Navigation.Uri),
			Lobby,
			Game);
		Evaluation.StateChanged += HandleEvaluationStateChanged;
	}

	private void HandleEvaluationStateChanged(object? sender, EventArgs args) =>
		_ = InvokeAsync(StateHasChanged);

	public void Dispose() => Evaluation.StateChanged -= HandleEvaluationStateChanged;
}
