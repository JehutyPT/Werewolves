<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- GitHub Packages requires a Repository URL to associate the package -->
    <RepositoryUrl>https://github.com/bicheichane/Werewolves.Core</RepositoryUrl>
    <PackageId>bicheichane.Werewolves.Core.StateModels</PackageId>
    <Version>1.0</Version>
    <!-- Namespace convention matters here -->
  </PropertyGroup>


  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Werewolves.Core.GameLogic</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Werewolves.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\GameStrings.resx">
      <StronglyTypedClassName>GameStrings</StronglyTypedClassName>
      <StronglyTypedNamespace>Werewolves.Core.StateModels.Resources</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)GameStrings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Interfaces\" />
  </ItemGroup>

  <!-- Add MinVer for automatic versioning based on Git Tags -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="5.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
